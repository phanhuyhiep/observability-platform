                },
                "ACKNOWLEDGED": {
                  "color": "orange",
                  "index": 1,
                  "text": "ACKNOWLEDGED"
                },
                "INVESTIGATING": {
                  "color": "yellow",
                  "index": 2,
                  "text": "INVESTIGATING"
                },
