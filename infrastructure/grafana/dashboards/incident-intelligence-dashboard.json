                  "color": "green",
                  "index": 4,
                  "text": "RESOLVED"
                },
                "CLOSED": {
                  "color": "purple",
                  "index": 5,
                  "text": "CLOSED"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "critical": {
                  "color": "red",
                  "index": 0,
                  "text": "CRITICAL"
                },
                "high": {
                  "color": "orange",
                  "index": 1,
                  "text": "HIGH"
                },
                "warning": {
                  "color": "yellow",
                  "index": 2,
                  "text": "WARNING"
                },
                "low": {
                  "color": "blue",
                  "index": 3,
                  "text": "LOW"
                }
              },
              "type": "value"
            }
          ]
